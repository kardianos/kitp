idx_comm_log_route_at, "route_id, at desc"


## table activity_sink_secret | doc="Encrypted MS Graph (or future provider) client_secret for an activity_sink card. One row per sink; sink_card_id is the PK + FK with ON DELETE CASCADE so deleting the sink drops the secret. client_secret is a bytea cell written via pgcrypto's pgp_sym_encrypt (key from KITP_COMM_SECRET_KEY env var — same GUC the comm_secret table uses, kept singular to avoid a second secret-key surface)."

### columns
name, type, pk, nullable, default, references, on_delete
sink_card_id, bigint, true, , , card.id, cascade
client_secret, bytea, , , , ,
updated_at, timestamptz, , false, now(), ,


## table activity_sink_state | doc="Per-delivery-unit high-water mark + last-error + rollup clock for the activity pump. A delivery unit is either a broadcast activity_sink (msgraph_teams) or a personal activity_subscription under an email sink; sink_card_id holds that unit's card id. Separated from the card's attributes so the pointer can advance every push without writing a fresh attr_update activity row (which would re-enter the activity stream and cause feedback). last_activity_id is the largest activity.id this unit has consumed; the pump scans WHERE id > last_activity_id. pending_since is the created_at of the oldest matched-but-undelivered activity row: the unit holds delivery until pending_since + rollup_minutes, then sends everything matched so far as one digest and clears it."

### columns
name, type, pk, nullable, default, references, on_delete
sink_card_id, bigint, true, , , card.id, cascade
last_activity_id, bigint, , false, 0, ,
last_pushed_at, timestamptz, , , , ,
last_pushed_count, bigint, , false, 0, ,
last_error, text, , , , ,
pending_since, timestamptz, , , , ,
updated_at, timestamptz, , false, now(), ,

## table bundle | doc="Catalog of built-in feature bundles and project presets, materialised from db/schema/bundles/*.hcsv by store.ApplySchema on every boot whose file checksum changed. A FEATURE (kind='feature') owns a hidden source project (is_template=true + bundle_key) holding its cards; bundle.apply / project.compose merge-copy that source into a target project via copy_project_template_merge. A PRESET (kind='preset') is a named, ordered list of feature keys (features) offered by the new-project dialog. Code-owned: an admin edit to a source project is overwritten the next time its file changes."

