flow_id,  from_card_id,  to_card_id,    label,             sort_order, standalone
@pb_flow, @pb_draft,     @pb_review,    "Send to review",  1,          true
@pb_flow, @pb_draft,     @pb_published, "Publish",         2,          false
@pb_flow, @pb_draft,     @pb_archived,  "Archive",         3,          false
@pb_flow, @pb_review,    @pb_published, "Publish",         1,          true
@pb_flow, @pb_review,    @pb_draft,     "Back to draft",   2,          false
@pb_flow, @pb_review,    @pb_archived,  "Archive",         3,          false
@pb_flow, @pb_published, @pb_published, "Publish changes", 1,          true
@pb_flow, @pb_published, @pb_review,    "Send to review",  2,          false
@pb_flow, @pb_published, @pb_draft,     "Unpublish edits", 3,          false
@pb_flow, @pb_published, @pb_archived,  "Archive",         4,          false
@pb_flow, @pb_archived,  @pb_draft,     "Restore",         1,          true

