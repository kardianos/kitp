# bundle | key=publishing | title="Publishing" | sort=30 | doc="Pages you write, review and publish to portals: a page status flow (Draft → In review → Published → Archived), a Pages screen, and a starter Home page. In Admin → Values, choose which portals each status publishes to — e.g. In review → QA, Published → QA and PROD."

-- Feature bundle: publishable pages (see tracker.hcsv for how bundle files
-- are materialised and applied).
--
-- Pages are `page` cards under the project; a page's child pages are its
-- section, so the card tree IS the site tree. A page moves through the
-- publish_status flow below. When it ENTERS a status whose publishes_to
-- names a portal, the page is snapshotted onto that portal
-- (publication_sync). Entering Draft (triage: not live) takes it off every
-- other portal — "Unpublish"; entering Archived (terminal) takes it off
-- all of them. Entering a live status (In review, Published) leaves the
-- other portals alone, so editing a live page leaves each portal on its
-- pinned revision until "Publish changes" (or a trip back through review)
-- re-enters a publishing status.
--
-- The bundle can't know an install's portals, so its statuses publish
-- nowhere until an admin links them.

## table card | alias=bundle_src
### rows
card_type_id, title, is_template, bundle_key
$card_type.project, "Bundle: Publishing", true, publishing

## table card | under=bundle_src
### rows
card_type_id,      parent_card_id, phase,    title,       sort_order, alias
$card_type.status, parent,         triage,   "Draft",     10,         pb_draft
$card_type.status, parent,         active,   "In review", 20,         pb_review
$card_type.status, parent,         active,   "Published", 30,         pb_published
$card_type.status, parent,         terminal, "Archived",  40,         pb_archived

## table flow
### rows
name,         attribute_def_id,              scope_card_id, default_create_status_id, alias
"Publishing", $attribute_def.publish_status, @bundle_src,   @pb_draft,                pb_flow

-- "Publish changes" is a Published → Published step: re-entering the status
-- re-snapshots the page, so an edit to a live page goes out without a trip
-- through review.
