## function activity_sink_list_batch | doc="activity_sink.list — list activity_sink cards under input.project_id joined with activity_sink_secret (has_client_secret only) and activity_sink_state (pump pointer + last error). Admin-only." | path="functions/activity_sink_list_batch.sql"
## function attribute_def_select_batch | doc="attribute_def.select — list every attribute_def with bound (card_type, is_required, ordering) edges. Optional input filters by id or name for symmetry with future single-row lookups." | path="functions/attribute_def_select_batch.sql"
## function attachment_list_batch | doc="attachment.list — list active attachments for a card (joined with file row), newest first; result.rows is a JSONB array shaped like attachment.Row." | path="functions/attachment_list_batch.sql"
## function card_select_batch | doc="card.select — list cards filtered by optional parent_card_id / card_type_name; soft-deleted excluded; per-actor visibility predicate (B7) applied. Title is null in this lighter read path." | path="functions/card_select_batch.sql"
## function card_search_batch | doc="card.search — typeahead read returning (id, title) hits within a card_type; supports substring query, numeric-id fast-path, explicit ids[] filter, optional parent_card_id; per-actor visibility predicate (B7) applied." | path="functions/card_search_batch.sql"
## function comm_list_for_task_batch | doc="comm.list_for_task — list comm cards under a task, hydrated with replies (reply_body rows from the replies card_ref[] attribute) + recipients (comm_recipients card_ref[] as []string ids). Per-actor visibility predicate (B7) applied." | path="functions/comm_list_for_task_batch.sql"
## function comm_channel_list_batch | doc="comm_channel.list — admin-only list of comm_channel cards under a project, with multi-attribute hoisting + comm_secret join to surface has_imap_password / has_smtp_password without exposing encrypted bytes." | path="functions/comm_channel_list_batch.sql"
## function comm_log_list_batch | doc="comm_log.list — admin-only paginated read of comm_log rows for a project, optionally filtered by kind + since timestamp (defaults to last 24h); channel_name joined via the channel card's title attribute." | path="functions/comm_log_list_batch.sql"
## function comm_unseen_count_batch | doc="comm.unseen_count — cheap count of newly received comms (received reply_body cards) across every project the caller can see, with create-activity id > since_activity_id; drives the header notification bell. Per-actor visibility (B7) gated one hop on the task's project." | path="functions/comm_unseen_count_batch.sql"
## function approval_set_batch | doc="approval.set — ask people to approve or reject one of a task's status actions (an approval card under the task: action snapshot, approvers, note), or PATCH who is asked / the note. Documentation, never a gate. Changed attributes write activity rows (the audit trail)." | path="functions/approval_set_batch.sql"
## function approval_remove_batch | doc="approval.remove — soft-delete an approval request (card_delete activity row); decisions already given stay in the task's history." | path="functions/approval_remove_batch.sql"
## function approval_decide_batch | doc="approval.decide — record the caller's approve / reject vote on a status edge of the task (named directly or through a request) as an immutable approval_decision activity row on the task (optional reason in comment_body). Agents may vote (shown with their owner) but never answer a request for a person. Moves nothing." | path="functions/approval_decide_batch.sql"
## function approval_list_batch | doc="approval.list — a task's approvals in one read: current status, the status-flow actions, live requests (with reached_at) and every vote (with settled / stale), for the task page's Approvals section." | path="functions/approval_list_batch.sql"
## function activity_actors_batch | doc="activity.actors — the accounts that can make changes in a project (holders of a global or project-scoped role, plus the agents they own, plus any requested ids), each named by user_label; the caller must see the project (DI-6). Feeds the actor pickers of activity filters." | path="functions/activity_actors_batch.sql"
## function activity_comment_body_id | doc="The comment_body an activity row shows, or NULL: only a comment and an approval vote carry one (value_new.comment_body_id), checked before the cast." | path="functions/activity_comment_body_id.sql" | arg_types="text, jsonb"
## function activity_select_batch | doc="activity.select — paged activity for one card (or cross-card when card_id is omitted) with comment_body bodies hydrated for kind=comment rows; per-actor visibility predicate (B7) applied in both modes." | path="functions/activity_select_batch.sql"
## function activity_poll_batch | doc="activity.poll — cheap newer-activity check for the task-detail background poll: given task_id + since_activity_id, returns latest_activity_id + new_count across the task AND its comm + link child cards (so one cursor catches new comments, threads, replies, and forge updates to linked changes). Visibility gated once on the task." | path="functions/activity_poll_batch.sql"
## function cas_missing_chunks_batch | doc="cas.missing_chunks — anti-join input addresses against cas_blob; result.missing[] preserves input ordinality so duplicated input addresses appear duplicated in the output (matches the legacy Go-side unnest behaviour). Empty / missing addresses[] returns missing=[]." | path="functions/cas_missing_chunks_batch.sql"
## function _canon_card_ref | doc="Canonicalise a jsonb value against an attribute_def.value_type. card_ref string-of-digits becomes a JSON number; card_ref[] applies elementwise; other shapes pass through. Mirrors schema.Snapshot.CanonicalizeValue." | path="functions/canon_card_ref.sql" | arg_types="jsonb, text"
## function _ph_push | doc="Placeholder-bag append primitive for card_compile_predicate (A13 / BE-H2 safe increment). Appends a value to the JSONB params bag and returns (new_bag, 0-based index) so no predicate leaf hand-counts a placeholder offset. Declared before card_compile_predicate." | path="functions/ph_push.sql" | arg_types="jsonb, jsonb"
## function card_compile_predicate | doc="Recursive predicate-tree compiler used by card_select_with_attributes_batch. Walks the v2 tree (connective / leaf / snippet) and emits a SQL boolean fragment plus an accumulated JSONB params bag. Mirrors the Go-side card.CompileTree." | path="functions/card_compile_predicate.sql" | arg_types="jsonb, jsonb, bigint[], bigint"
## function card_filter_ids | doc="The subset of ids whose cards satisfy a predicate tree (compiled once by card_compile_predicate, then EXECUTEd against the id list). NULL / empty tree passes every id. Backs attribute_def.target_filter: card.search narrows picker candidates with it; attribute.update / card.insert validate newly chosen card_ref values." | path="functions/card_filter_ids.sql" | arg_types="jsonb, bigint[]"
## function _resolve_me_tokens | doc="Rewrite the dynamic '@me' person-ref token in a predicate-tree JSONB to a concrete person card id, so card_compile_predicate only ever sees concrete ids. Run as a pre-pass by card_select_with_attributes_batch with the caller's person card id — powers dynamic per-viewer filters (assignee/originator == me)." | path="functions/resolve_me_tokens.sql" | arg_types="jsonb, bigint"
## function card_select_with_attributes_batch | doc="card.select_with_attributes — SPA's main read path. Compiles the v1 where[] / v2 tree via card_compile_predicate, layers in optional personal_sort / routed_to_me joins + ordering LATERALs, EXECUTEs the dynamic SQL, returns each input's rows as a JSONB array under result.rows. Per-actor visibility predicate (B7) AND-joined." | path="functions/card_select_with_attributes_batch.sql"
## function flow_list_batch | doc="flow.list — list flow rows, optionally filtered by scope_card_id (project) and / or attribute_def_id. Joined to attribute_def for the display name." | path="functions/flow_list_batch.sql"
## function flow_preview_delete_batch | doc="flow.preview_delete — read-shaped V16 dry-run preview for flow.delete. Returns flow_name + step_count + affected-task counts bucketed by phase + up to 5 sample step labels in sort order." | path="functions/flow_preview_delete_batch.sql"
## function flow_step_list_batch | doc="flow_step.list — list flow_step rows for one flow, joined LEFT to role for the optional requires_role name. Sorted by (sort_order, label, id)." | path="functions/flow_step_list_batch.sql"
## function flow_step_list_for_card_batch | doc="flow_step.list_for_card — read-side affordance API: walk parent_card_id (RECURSIVE depth<16) to find the enclosing project, then list every flow_step the card may currently fire — one row per (flow, attribute_def, from_card_id=card's value) match — pre-joined with from/to titles+phases, optional requires_role name, and a per-actor allowed bit (system bypass + project-or-global scope check)." | path="functions/flow_step_list_for_card_batch.sql"
## function card_type_select_batch | doc="card_type.select — list every card_type row (global reference data; no per-input filter today). One input → one result row; same snapshot replicated per input." | path="functions/card_type_select_batch.sql"
