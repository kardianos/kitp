display_name, text, , , false, , , 
email, text, , , , , , 
parent_user_id, bigint, , , , , user_account.id, cascade
is_agent, boolean, , , false, false, , 
created_at, timestamptz, , , false, now(), , 

## table session | doc="Server-side session for the BFF auth model. `id` is the SHA-256 hex of the opaque value the kitp_session cookie carries (auth.HashSecret; the cookie value itself is never stored, nor the OIDC token). `created_at` anchors the absolute re-auth cap; `last_seen_at` is the sliding idle window updated by Manager batched-touch flushes. `revoked_at` set on logout / admin revoke. `oidc_sub` records the OP subject for OIDC sessions so we can rotate when sub changes."

### columns
name, type, pk, nullable, default, references, on_delete
id, text, true, , , , 
user_id, bigint, , false, , user_account.id, cascade
created_at, timestamptz, , false, now(), , 
last_seen_at, timestamptz, , false, now(), , 
revoked_at, timestamptz, , , , , 
oidc_sub, text, , , , , 

### indexes
name, columns
session_user_id, "user_id"
session_last_seen_at, "last_seen_at"

## table oidc_state | doc="Short-lived PKCE staging for the server-managed OIDC redirect dance. /auth/oidc/start writes a row keyed by `state` (with the PKCE verifier and the nonce sent to the OP) and sets a cookie carrying the state; /auth/oidc/callback requires that cookie, reads + deletes the row, and checks the id_token's nonce. Rows past `expires_at` are reaped by a periodic sweep."

### columns
name, type, pk, nullable, default
state, text, true, , 
verifier, text, , false, 
redirect, text, , false, '/'
nonce, text, , false, ''
created_at, timestamptz, , false, now()
expires_at, timestamptz, , false, 

### indexes
name, columns
oidc_state_expires_at, "expires_at"

## table user_token | doc="Opaque bearer tokens that authenticate an MCP (or future remote) client AS a specific user_account row. Typical use: a human mints a token bound to one of their agent user_accounts, hands it to the MCP client out-of-band. The token is 32 random bytes base64url-encoded — same shape as the session cookie — with nothing meaningful embedded; `id` stores only its SHA-256 hex (auth.HashSecret), so the token is shown once at creation and can't be read back. last_used_at participates in the same batched-touch pattern as session.last_seen_at. ON DELETE CASCADE so revoking the agent user_account row revokes every token bound to it. label is required and unique per user so user_token.list / user_token.revoke can address rows without leaking the secret value back to the wire — list returns labels + timestamps, revoke takes (user_id, label). scope narrows what the token may do: '' = unrestricted (MCP + every bearer route); 'links' = only the forge link hook (POST /api/v1/links) — the credential a code forge holds. The api.Router enforces it per route." | unique="user_id, label"

### columns
name, type, pk, nullable, default, references, on_delete
id, text, true, , , , 
user_id, bigint, , false, , user_account.id, cascade
label, text, , false, , , 
created_at, timestamptz, , false, now(), , 
last_used_at, timestamptz, , false, now(), , 
revoked_at, timestamptz, , , , , 
expires_at, timestamptz, , , , , 
scope, text, , false, '', , 

### indexes
name, columns
user_token_user_id, "user_id"
user_token_last_used_at, "last_used_at"

## table user_card_agent | doc="Per-(parent-user, card) routing of a task to one of the parent's agents. The parent owns the assignment; other users in the project never see it. The agent's inbox query joins this table on `agent_user_id = me AND user_id = my_parent`. PK (user_id, card_id) limits one card to one routed agent per parent — sufficient for 'alice has card 42 routed to her research agent' without enabling cross-agent fan-out, which would just be confusing." | primary_key="user_id, card_id"

### columns
