## table idempotency_claim | doc="A keyed batch request in flight: claimed before it runs, dropped when it finishes, so a concurrent retry with the same Idempotency-Key waits (409 idempotency_in_progress) instead of running too. A claim older than 15 minutes (its process died) can be taken over; idempotency.cleanup purges leftovers." | primary_key="user_id, key"

