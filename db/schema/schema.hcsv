## table attribute_value | doc="Current value of one attribute on one card. last_activity_id points at the activity row that set this value. value_type_id denormalizes the def's storage class onto the row (<1000 = structured/JSONB, >=1000 = plain text) so the value indexes can partition by class without a join: structured values get the (attribute_def_id, value) btree for equality, text values get the trigram and are kept OUT of the btree (a large markdown body would otherwise overflow the 2704-byte btree tuple cap). Set by the attribute_value_set_type_id trigger from attribute_def.value_type, which is immutable." | primary_key="card_id, attribute_def_id"

### columns
name, type, nullable, references
card_id, bigint, false, card.id
attribute_def_id, bigint, false, attribute_def.id
value, jsonb, ,
value_type_id, int, false,
last_activity_id, bigint, , activity.id

### indexes
name, columns, expressions, using, where
attribute_value_trgm, , "(value::text) gin_trgm_ops", gin, "value_type_id >= 1000"
attribute_value_def_value, "attribute_def_id, value", , , "value_type_id < 1000"
attribute_value_def_card, "attribute_def_id, card_id", , ,
attribute_value_def_ref, , "attribute_def_id, ((value)::text::bigint)", , "jsonb_typeof(value) = 'number'"
attribute_value_refs, , "value jsonb_path_ops", gin, "jsonb_typeof(value) = 'array'"

