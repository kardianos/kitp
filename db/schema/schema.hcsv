-- ---------------------------------------------------------------------
-- Handler functions (unified handler model — docs/UNIFIED_HANDLER_PLAN.md).
-- Every batch handler with `reg.Handler.SQLFunc` set has its body here.
-- Signature is `(actor_id bigint, inputs jsonb) RETURNS TABLE(idx int,
-- ok boolean, code text, message text, result jsonb)` — uniform so the
-- dispatcher's wrapper code is one shape.
-- ---------------------------------------------------------------------

## function av_value_type_id | doc="Map an attribute_def.value_type to its storage-class id, denormalized onto attribute_value.value_type_id. <1000 = structured (JSONB equality via the (attribute_def_id, value) btree); >=1000 = plain text (trigram only, kept out of the btree so a large markdown body can't overflow the 2704-byte btree tuple cap). Single source of the mapping for both the attribute_value_set_type_id trigger and the backfill migration." | path="functions/av_value_type_id.sql" | arg_types="text"
## function iso_date_ok | doc="True when a text is a date in the one form kitp stores: exactly YYYY-MM-DD and a real day. Every date that enters kitp is checked with it (Go twin: internal/isodate); Postgres's own date input ('today', '03/11/2026') is never used to accept one. Declared before the handlers that call it." | path="functions/iso_date_ok.sql" | arg_types="text"
## function iso_timestamp_ok | doc="True when a text is an RFC 3339 timestamp (date, T, hh:mm:ss, optional fraction, Z or ±hh:mm) naming a real instant. Inputs are checked with it before any ::timestamptz cast, which would also take 'now' or 'infinity'." | path="functions/iso_timestamp_ok.sql" | arg_types="text"
## function attribute_value_set_type_id | doc="BEFORE INSERT trigger on attribute_value: sets value_type_id from the def's value_type via av_value_type_id. value_type is immutable per def and attribute_def_id never changes, so set-on-insert keeps the denormalized class correct with no re-sync. The body also declares the trigger; DROP TRIGGER IF EXISTS + CREATE TRIGGER re-apply it each boot." | path="functions/attribute_value_set_type_id.sql" | arg_types=""
## function card_ancestors | doc="Shared capped parent_card_id walk (A1 / BE-C1 / SEC-1). Returns the ancestor chain of a card (inclusive) with a 0-based depth column; the recursive arm carries WHERE depth < 16 so a parent cycle can't pin a connection. The single source of the depth cap (A15d)." | path="functions/card_ancestors.sql" | arg_types="bigint"
## function card_enclosing_project | doc="Resolve a card's enclosing project (first card_type='project' ancestor within the depth cap) via card_ancestors. Canonical card→project resolver (A10 / BE-M3); declared after card_ancestors because its SQL body references it at create time." | path="functions/card_enclosing_project.sql" | arg_types="bigint"
## function role_covers | doc="Whether holding one role covers another: the same role, or a built-in role ranked at or above it (viewer < commenter < worker < manager < admin; role.rank). Declared before user_role_effective, which calls it." | path="functions/role_covers.sql" | arg_types="bigint, bigint"
## function user_role_effective | doc="The role rows a user can use: a person's own user_role rows; an agent's own rows that its owner covers (role_covers: the same role or a higher one, at that scope or workspace-wide). Every role check reads it, so an agent never exceeds its owner. Declared before the SQL functions that call it." | path="functions/user_role_effective.sql" | arg_types="bigint"
## function user_has_step_role | doc="Whether an account may take a flow step that needs a role (NULL = anyone) in a project: the system role globally, or a role that covers it (role_covers) globally or on the project. One rule for attribute.update's flow gate, card.insert's starting state and the step lists' allowed bits." | path="functions/user_has_step_role.sql" | arg_types="bigint, bigint, bigint"
## function user_role_visible | doc="The role rows that decide what a user can see (DI-6): a person's own; an agent's owner's — an agent sees exactly what its owner sees. What a user can do reads user_role_effective." | path="functions/user_role_visible.sql" | arg_types="bigint"
## function user_is_global_admin | doc="Whether a user holds admin workspace-wide, by user_role_effective. The one admin check behind admin-only handlers and the role gate." | path="functions/user_is_global_admin.sql" | arg_types="bigint"
## function card_in_off_area | doc="Areas: true when a card, or a card above it, has an item type of an area that is switched off (in the card's project, or workspace-wide). Such a card is hidden from every read and refused for writes. Fast path when nothing is off. See docs/AREAS.md." | path="functions/card_in_off_area.sql" | arg_types="bigint"
## function area_write_blocked | doc="Areas: the dispatcher's write check — true when a write of a card type, on a card, in a project would touch an area that is off." | path="functions/area_write_blocked.sql" | arg_types="bigint, bigint, bigint"
## function workspace_area_off | doc="Areas: true when a workspace-scoped area (Sites) is switched off." | path="functions/workspace_area_off.sql" | arg_types="text"
## function card_visible_to | doc="Per-row read predicate (DI-6) for one card: true when the caller (or an agent's owner) holds a global user_role or one scoped to the card's enclosing project, and the card isn't in an area that is switched off. Mirrors schema.VisibilityClause." | path="functions/card_visible_to.sql" | arg_types="bigint, bigint"
## function card_ref_cross_project | doc="Check whether a card's stored card_ref / card_ref[] values would cross a project boundary for a given target enclosing project (A11 / BE-M5). Returns the first offending (attr, value_card, value_project) or no rows. Reuses card_enclosing_project; declared after it. Used by card.move to re-validate the cross-project ref invariant on re-parent." | path="functions/card_ref_cross_project.sql" | arg_types="bigint, bigint"
## function user_label | doc="How a user_account is named where the UI or a message says who did something: the display name, plus the owner for a personal agent ('claude (for Daniel)'); a workspace agent (owned by System) keeps its bare name. Shared by activity.select, comm.list_for_task, link.list, the SMTP signature and the activity-sink digests." | path="functions/user_label.sql" | arg_types="bigint"
## function card_label | doc="A card's display title: its title attribute, else its reply_subject (reply_body cards have no title). Used by activity.select." | path="functions/card_label.sql" | arg_types="bigint"
## function activity_nav_card | doc="The card an activity row belongs to in the UI: the nearest task ancestor-or-self, a reply_body's comm's task, else the card itself. Reuses card_ancestors; declared after it. Used by activity.select." | path="functions/activity_nav_card.sql" | arg_types="bigint"
## function user_sees_project | doc="DI-6 visibility for one project: the user (or an agent's owner) holds a global role or one scoped to the project or a card above it. Used by the approval handlers for the caller and for the people a request names. Declared after card_ancestors." | path="functions/user_sees_project.sql" | arg_types="bigint, bigint"
## function user_has_grant | doc="Whether a user holds a role granting a process on a card_type, globally or scoped to the project: the dispatcher's per-row authz rule, for a second write a handler makes (approval.set starting an email thread checks comm card.create)." | path="functions/user_has_grant.sql" | arg_types="bigint, text, text, bigint"
## function task_status_action | doc="The status-flow step an approval names: from → to in the flow bound to status in the task's project (lowest sort_order when a pair has several labels); no row when there is none. Declared after card_enclosing_project." | path="functions/task_status_action.sql" | arg_types="bigint, bigint, bigint"
## function status_ref_json | doc="A status value-card as the approval reads ship it: {id, label, phase}. Declared after card_label." | path="functions/status_ref_json.sql" | arg_types="bigint"
## function approval_fields | doc="One approval request's fields in a row (from_id, to_id, action, approvers, note, comm_id), each cast guarded inside a CASE so no query plan applies it to another attribute's value." | path="functions/approval_fields.sql" | arg_types="bigint"
## function approval_round_start | doc="Where the current round of votes on an edge begins: the last time the task's status changed to the edge's target (NULL when never). Earlier votes were settled when the task got there." | path="functions/approval_round_start.sql" | arg_types="bigint, bigint"
## function approval_tally | doc="How an approval request stands: of the people it asks, how many approved / rejected its edge by each person's latest vote in the edge's current round. Declared after approval_round_start." | path="functions/approval_tally.sql" | arg_types="bigint, bigint, bigint, jsonb"
## function approval_open | doc="A task's open approval requests (id, from_id, to_id, approvers, created_at): live approval cards whose step target the task hasn't reached since they were asked, on a task not in a terminal status. The one definition of open behind the task's approval properties. Declared after approval_fields and approval_round_start." | path="functions/approval_open.sql" | arg_types="bigint"
## function approval_waiting_on | doc="Whether a task waits on any of the given people for a vote: an open request asks them and they haven't voted on its step this round (agent votes never answer for a person). Backs the Vote needed from filter. Declared after approval_open." | path="functions/approval_waiting_on.sql" | arg_types="bigint, bigint[]"
## function approval_summary | doc="A task's Approvals column: {state, asked, approved, rejected, asked_at, waiting_on_me} over its open requests, or NULL. Used by card.select_with_attributes on with_approvals and by approval_state. Declared after approval_tally and approval_waiting_on." | path="functions/approval_summary.sql" | arg_types="bigint, bigint"
## function approval_state | doc="A task's approval state for filters and sorting: open, rejected, approved or none. Declared after approval_summary." | path="functions/approval_state.sql" | arg_types="bigint"
## function approval_asked_at | doc="When a task's oldest open approval request was made (NULL when none). Backs the Approval asked filter and sort. Declared after approval_open." | path="functions/approval_asked_at.sql" | arg_types="bigint"
## function comment_insert_batch | doc="comment.insert — validate + write per row." | path="functions/comment_insert_batch.sql"
## function flow_state_ids | doc="The live value cards that are states of one flow (its default_create_status_id plus every flow_step from / to card). A flow-bound attribute may only hold one of these; attribute.update / card.insert / task.move reject anything else so a card can't be stranded on a value no step leaves." | path="functions/flow_state_ids.sql" | arg_types="bigint"
## function build_flow_available_array | doc="V13 helper: emits the available[] JSONB array for a flow rejection envelope. Mirrors flow.listAvailableTransitions in PL/pgSQL." | path="functions/build_flow_available_array.sql" | arg_types="bigint, bigint, bigint"
## function attr_scalar_norm | doc="The stored form of a text or bool attribute value (a JSON string; a JSON boolean), or NULL when the value can't be one. attribute.update and card.insert store it; an object or array is never a text or bool." | path="functions/attr_scalar_norm.sql" | arg_types="text, jsonb"
## function attribute_update_batch | doc="attribute.update — validate (card / edge / required-removal / project-scope / screen-uniqueness / flow gate) and write per row." | path="functions/attribute_update_batch.sql"
## function attachment_kind | doc="Display bucket for an attachment (image | pdf | markdown | other) from its mime type + filename; markdown also matches a .md / .markdown extension since browsers rarely agree on its mime type. Shared by attachment.create and attachment.list." | path="functions/attachment_kind.sql" | arg_types="text, text"
## function attachment_delete_batch | doc="attachment.delete — soft-delete + activity row per input." | path="functions/attachment_delete_batch.sql"
## function attachment_create_batch | doc="attachment.create — validate + link existing file to card + activity row per input; thumb_file_id is NULL at SQL level and the dispatcher's PostRun hook (doThumbnails) fills it in after Go-side image decode." | path="functions/attachment_create_batch.sql"
## function attachment_download_url_batch | doc="attachment.download_url — validate id+mode + resolve file/thumb metadata per input; the dispatcher's PostRun hook (signDownloadURLs) appends a time-limited HMAC-signed url + expires_at after the SQL returns." | path="functions/attachment_download_url_batch.sql"
## function attachment_upload_url_batch | doc="attachment.upload_url — validate card_id + filename (extension gate) + live card per input and echo the normalised card_id/filename/mime_type; the dispatcher's PostRun hook (signUploadURLs) appends a time-limited HMAC-signed one-shot upload url + expires_at after the SQL returns." | path="functions/attachment_upload_url_batch.sql"
## function remap_predicate_tree | doc="Walk a predicate-tree JSONB value and rewrite card_ref ids on every leaf whose attr names a card_ref / card_ref[] attribute. Recurses into children[] (connective nodes) and items[].predicate (toggle_groups). Used by copy_project_template." | path="functions/remap_predicate_tree.sql" | arg_types="jsonb, jsonb, text[]"
## function copy_project_template_merge | doc="Graph-copy a template (or feature bundle source) project's descendants into a target project with id remap — cards, flows, flow_steps, attribute_values incl. predicate-tree card-ref remap. origin NULL = plain stamp into a fresh project; origin=<bundle key> = MERGE into an existing project: cards keyed by card_type:title path, items the target already holds (card_origin) map instead of copying, copied cards record card_origin, existing flows gain only missing steps. Returns {copied, existing}." | path="functions/copy_project_template_merge.sql" | arg_types="bigint, bigint, bigint, text"
## function copy_project_template | doc="Stamping entry point: plain graph-copy of a template project's descendants into a fresh new_project_id via copy_project_template_merge(…, NULL). Used by card_insert_batch (auto-stamp) and project_stamp_batch." | path="functions/copy_project_template.sql" | arg_types="bigint, bigint, bigint"
## function bundle_source_purge | doc="Hard-delete a feature bundle's hidden source project subtree (flows, flow_steps, attribute values, activity, cards) so ApplySchema can re-materialise it from its file. Refuses any project not flagged is_template + bundle_key." | path="functions/bundle_source_purge.sql" | arg_types="bigint"
## function bundle_apply | doc="Merge one feature bundle's source project into a project via copy_project_template_merge (origin = bundle key). Refuses (status conflict) a first apply whose flows bind an attribute the project already drives; a re-apply adds only missing items. Returns {key, status, copied, existing, message}." | path="functions/bundle_apply.sql" | arg_types="bigint, text, bigint"
## function bundle_apply_batch | doc="bundle.apply — add feature bundles (keys, in order) to an existing project; a conflict or unknown key fails the row." | path="functions/bundle_apply_batch.sql"
## function bundle_list_batch | doc="bundle.list — the install's feature bundles and presets; with project_id, which features that project has (enabled) and which it can't take (conflict)." | path="functions/bundle_list_batch.sql"
## function portal_mark_dirty | doc="Flag a portal for the portal.build job: dirty_since = clock_timestamp(), so a change landing mid-build keeps it dirty (the builder clears the flag only if dirty_since is unchanged)." | path="functions/portal_mark_dirty.sql" | arg_types="bigint"
## function publication_sync | doc="Apply a page's current publish_status to the portals: entering a status whose publishes_to names portals snapshots the page onto each; a terminal status withdraws it from all; any other status leaves the pinned snapshots alone. Marks touched portals dirty." | path="functions/publication_sync.sql" | arg_types="bigint, bigint"
## function publication_withdraw | doc="Take a page off every portal (card.delete calls it); marks those portals dirty." | path="functions/publication_withdraw.sql" | arg_types="bigint"
## function publication_after_write | doc="attribute.update's publishing hook: a page's publish_status write → publication_sync; any portal attribute write → portal_mark_dirty." | path="functions/publication_after_write.sql" | arg_types="bigint, text, bigint"
## function portal_set_batch | doc="portal.set — create or update a portal card (title, root page, public host, public flag); host names unique among live portals; changed attributes only; marks the portal dirty." | path="functions/portal_set_batch.sql"
## function portal_list_batch | doc="portal.list — live portals with root page, host, the statuses that publish to them, and active-build state; global-role callers see all, others the portals whose root page they can see." | path="functions/portal_list_batch.sql"
## function portal_root_pages_batch | doc="portal.root_pages — the pages a portal may use as its root: live pages in live, non-template projects the caller can see (so feature-bundle source pages never appear), each labelled 'Project › Page › …'." | path="functions/portal_root_pages_batch.sql"
## function portal_rebuild_batch | doc="portal.rebuild — queue a portal for the portal.build job." | path="functions/portal_rebuild_batch.sql"
## function area_present | doc="Areas: whether a project already has an area — it used one of the area's starting points, holds its items, or has its own status flow for them (a project from a template or from before areas)." | path="functions/area_present.sql" | arg_types="bigint, text"
## function area_state | doc="Areas: one area's state in a project ('on', 'off' or 'unused'; project 0 = the workspace): an explicit switch row wins, else 'on' when the project already has the area (area_present)." | path="functions/area_state.sql" | arg_types="bigint, text"
## function activity_hidden | doc="Areas: whether an activity row is hidden — with its card (card_in_off_area), or as a record of another area than its card's while that area is off (an approval vote on a task, with Approvals off)." | path="functions/activity_hidden.sql" | arg_types="text, bigint"
## function area_list_batch | doc="area.list — the areas of a project (or the workspace areas) with their state, starting points, the project's screens of each, and (admins) how many items each holds." | path="functions/area_list_batch.sql"
## function area_set_batch | doc="area.set — switch an area on (admin; turns on what it needs, adding starting points) or off (manager/admin; refused while a dependent area is on); writes an activity row and rebuilds affected portals." | path="functions/area_set_batch.sql"
## function theme_mark_portals_dirty | doc="Flag every live portal using a theme for the portal.build job (a theme's settings or files changed)." | path="functions/theme_mark_portals_dirty.sql" | arg_types="bigint"
## function theme_set_batch | doc="theme.set — create or update a theme card (title, base theme, nav mode, accent colour, footer); changed attributes only; rebuilds the portals using it. The Go PreRun checks the base against the built-in themes." | path="functions/theme_set_batch.sql"
## function theme_list_batch | doc="theme.list — live theme cards with their settings, override files and the portals using them." | path="functions/theme_list_batch.sql"
