## function agent_create_batch | doc="agent.create — insert a user_account (is_agent=TRUE, parent_user_id=actor) per input." | path="functions/agent_create_batch.sql"
## function agent_delete_batch | doc="agent.delete — null attribute_value.last_activity_id then delete activity rows + delete user_account (gated on is_agent=TRUE) per input." | path="functions/agent_delete_batch.sql"
